OPSPILOT_ENV=development
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@postgres:5432/opspilot
OPSPILOT_REDIS_URL=redis://redis:6379/0
OPSPILOT_SERVICE_NAME=opspilot-api
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_LOG_FORMAT=json
OPSPILOT_METRICS_ENABLED=true
OPSPILOT_METRICS_PORT=9100
OPSPILOT_OTEL_ENABLED=true
OPSPILOT_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
OPSPILOT_TASK_MODE=celery
OPSPILOT_TASK_SOFT_TIME_LIMIT_SECONDS=240
OPSPILOT_TASK_TIME_LIMIT_SECONDS=300
OPSPILOT_MODEL_PROVIDER=mock
OPSPILOT_MODEL_BASE_URL=http://model:8000/v1
OPSPILOT_MODEL_API_KEY=replace-me
OPSPILOT_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
OPSPILOT_MODEL_VERSION=opspilot-sft-dpo-v0.2
OPSPILOT_MODEL_TIMEOUT_SECONDS=30
OPSPILOT_MODEL_MAX_TOKENS=1024
# Set these to the serving provider's current USD prices; zero means unpriced.
OPSPILOT_MODEL_INPUT_COST_PER_MILLION_TOKENS=0
OPSPILOT_MODEL_OUTPUT_COST_PER_MILLION_TOKENS=0
OPSPILOT_MODEL_FALLBACK_TO_MOCK=true
OPSPILOT_MAX_MODEL_TURNS=8
OPSPILOT_MAX_TOOL_CALLS=12
OPSPILOT_MAX_RUN_SECONDS=180
OPSPILOT_ALERTMANAGER_WEBHOOK_TOKEN=change-me-before-production
OPSPILOT_APPROVAL_TTL_SECONDS=1800
