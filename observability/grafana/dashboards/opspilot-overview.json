{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests / second",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (route, status) (rate(opspilot_http_requests_total[5m]))", "legendFormat": "{{route}} {{status}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency P50 / P95",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(opspilot_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(opspilot_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Diagnosis outcomes",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (mode, outcome) (rate(opspilot_diagnosis_runs_total[5m]))", "legendFormat": "{{mode}} {{outcome}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Model latency P95",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, model) (rate(opspilot_model_request_duration_seconds_bucket[5m])))", "legendFormat": "{{model}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Model tokens / second",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "sum by (model, kind) (rate(opspilot_model_tokens_total[5m]))", "legendFormat": "{{model}} {{kind}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Model fallback rate",
      "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "sum by (reason) (rate(opspilot_model_fallbacks_total[5m]))", "legendFormat": "{{reason}}", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Estimated model cost",
      "id": 7,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [{"expr": "sum by (model) (increase(opspilot_model_estimated_cost_usd_total[1h]))", "legendFormat": "{{model}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["opspilot", "phase-3"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "OpsPilot Overview",
  "uid": "opspilot-overview",
  "version": 1
}
